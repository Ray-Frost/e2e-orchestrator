{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:validate": "prisma validate --schema ./prisma/schema.prisma",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:check": "pnpm db:validate && pnpm db:generate",
    "db:migrate:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "format": "pnpm -C ../.. exec prettier --write \"apps/server/src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "pnpm -C ../.. lint:server",
    "lint:fix": "pnpm -C ../.. lint:server:fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "source-map-support": "^0.5.21",
    "prisma": "^6.7.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
