{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:validate": "prisma validate --schema ./prisma/schema.prisma",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:check": "pnpm db:validate && pnpm db:generate",
    "db:migrate:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "format": "pnpm run format:write",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"*.{mjs,json}\"",
    "format:write": "pnpm exec prettier --write \"src/**/*.ts\" \"*.{mjs,json}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "pnpm exec tsx --test \"src/**/*.spec.ts\"",
    "lint": "pnpm exec eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings 0 --no-warn-ignored",
    "lint:fix": "pnpm exec eslint --config eslint.config.mjs \"src/**/*.ts\" --fix --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
